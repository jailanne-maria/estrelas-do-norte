rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /indicacoes/{document} {
      // O público pode criar uma sugestão com status "pendente".
      allow create: if
        request.resource.data.keys().hasOnly([
          'nome',
          'local',
          'area',
          'link',
          'motivo',
          'indicador',
          'contato',
          'consentimento',
          'origem',
          'status',
          'criadoEm',
          'criadoEmIso'
        ])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 120
        && request.resource.data.local is string
        && request.resource.data.local.size() > 0
        && request.resource.data.local.size() <= 120
        && request.resource.data.area is string
        && request.resource.data.motivo is string
        && request.resource.data.motivo.size() > 0
        && request.resource.data.motivo.size() <= 1200
        && request.resource.data.consentimento == true
        && request.resource.data.status == 'pendente';

      // Ninguém acessa as sugestões pelo site; a curadoria usa o console.
      allow read, update, delete: if false;
    }
  }
}
